# ── Frontend (Vercel) Environment Variables ─────────────────
# Set this in your Vercel Project Settings > Environment Variables:
# Replace with your deployed Render backend URL (e.g. https://winddesk-backend.onrender.com)
VITE_API_URL=https://winddesk-backend.onrender.com

# ── Backend (Render) Environment Variables ──────────────────
# Set these in Render Web Service Environment Variables (or let render.yaml configure them automatically):
PORT=8000
PYTHON_VERSION=3.12.1
WIND_DATA_DIR=backend/data
# Allowed origins for CORS (default: * allows all origins, or set your Vercel domain e.g. https://your-app.vercel.app)
CORS_ORIGINS=*
